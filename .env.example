# Vercel Postgres (Neon) — set after creating a database in Vercel
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Admin panel
ADMIN_PASSWORD=changeme
SESSION_SECRET=replace-with-a-long-random-string-min-32-chars

# La contraseña de votante NO es una variable de entorno: se guarda hasheada
# en la tabla `votings` y se cambia desde /admin/ajustes.

# Public app URL (used for share links / image absolute URLs if needed)
NEXT_PUBLIC_APP_URL=http://localhost:3000
